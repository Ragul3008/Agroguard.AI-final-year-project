# AgroGuard AI Backend - Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ── Database ───────────────────────────────────────────────────────
# Render provides this automatically when you add a managed PostgreSQL database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# ── ML Model ───────────────────────────────────────────────────────
MODEL_PATH=saved_models/agroguard_banana_convnext_v3.pth
MODEL_CONFIDENCE_THRESHOLD=0.75
MODEL_NOT_BANANA_THRESHOLD=0.40

# ── Gemini LLM ─────────────────────────────────────────────────────
# Get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# ── Location APIs ──────────────────────────────────────────────────
# Geoapify (primary) - free tier 3000 requests/day
# Get from https://www.geoapify.com/
GEOAPIFY_API_KEY=

# Google Maps (backup) - requires billing enabled
# Get from https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# ── JWT Authentication ─────────────────────────────────────────────
# Generate strong random secrets (32+ chars) for production
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-access-token-key-change-in-production
REFRESH_SECRET_KEY=your-super-secret-refresh-token-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth ───────────────────────────────────────────────────
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: https://your-backend.onrender.com/api/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Email (for password reset OTP) ─────────────────────────────────
# Using Resend (https://resend.com) - free tier 3000 emails/month
# Or SendGrid, Postmark, etc.
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@agroguard.ai

# ── Whisper ────────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=medium

# ── Server ─────────────────────────────────────────────────────────
# Render injects PORT automatically; don't set manually in production
PORT=8000
DEBUG=false

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Supports wildcards like https://*.vercel.app for Vercel preview deployments
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://agroguard.vercel.app,https://*.vercel.app