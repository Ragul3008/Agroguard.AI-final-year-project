# AgroGuard AI Frontend - Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ── API Base URL ───────────────────────────────────────────────────
# Backend URL (Render deployment)
# Local development: http://localhost:8000/api/v1
# Production: https://your-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://agroguard-api.onrender.com/api/v1

# ── Google OAuth ───────────────────────────────────────────────────
# Same client ID as backend (from Google Cloud Console)
# Authorized JavaScript origins: https://agroguard.vercel.app, http://localhost:5173
VITE_GOOGLE_OAUTH_CLIENT_ID=

# ── Optional: Analytics / Monitoring ───────────────────────────────
# VITE_SENTRY_DSN=
# VITE_GA_MEASUREMENT_ID=